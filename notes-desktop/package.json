{
  "name": "notes-desktop",
  "productName": "notes-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Markdown notes (codename notes-desktop)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "measure:startup": "electron-vite build && playwright test tests/e2e/startup.spec.ts -g budget --reporter=list",
    "dist": "electron-vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "echarts": "6.1.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "katex": "0.18.9",
    "motion": "13.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "author": "zhangzuhao"
}
